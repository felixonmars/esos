		rcpu0-dtb-gemini-c0 {
			description = "ESOS Core0 gemini_c0 dtb";
			type = "standalone";
			os = "esos";
			arch = "riscv";
			compression = "none";
			load = <0x1 0xeb4000>;
			entry = <0x1 0xeb4000>;
			data = /incbin/("../output/esos/k3_rt240_gemini_c0.dtb");
			hash {
