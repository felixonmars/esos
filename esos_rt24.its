				algo = "crc32";
			};
		};

		rcpu1-dtb-com260 {
			description = "ESOS Core1 Com260 dtb";
			type = "standalone";
			os = "esos";
			arch = "riscv";
			compression = "none";
			load = <0x1 0xe43800>;
			entry = <0x1 0xe43800>;
			data = /incbin/("../output/esos/k3_rt241_com260.dtb");
			hash {
				algo = "crc32";
			};
		};

		rcpu1-dtb-deb1 {
			description = "ESOS Core1 Deb1 dtb";
			type = "standalone";
			os = "esos";
			arch = "riscv";
			compression = "none";
			load = <0x1 0xe50000>;
			entry = <0x1 0xe50000>;
			data = /incbin/("../output/esos/k3_rt241_deb1.dtb");
