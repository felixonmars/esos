			};
		};

		rcpu1-dtb-gemini-c0 {
			description = "ESOS Core1 gemini_c1 dtb";
			type = "standalone";
			os = "esos";
			arch = "riscv";
			compression = "none";
			load = <0x1 0xec0800>;
			entry = <0x1 0xec0800>;
			data = /incbin/("../output/esos/k3_rt241_gemini_c0.dtb");
			hash {
				algo = "crc32";
			};
		};

		rcpu0-dtb-gemini-c1 {
			description = "ESOS Core0 gemini_c1 dtb";
			type = "standalone";
			os = "esos";
			arch = "riscv";
			compression = "none";
			load = <0x1 0xecd000>;
			entry = <0x1 0xecd000>;
			data = /incbin/("../output/esos/k3_rt240_gemini_c1.dtb");
			hash {
