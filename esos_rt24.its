/dts-v1/;

/ {
	description = "ESOS dual-core image for K3";
	#address-cells = <2>;

	images {
		rcpu-data-null {
			description = "Using data interaction with AP";
			type = "standalone";
			os = "esos";
			arch = "riscv";
			compression = "none";
			load = <0x1 0xe04000>;
			entry = <0x1 0xe04000>;
			data = /incbin/("../output/esos/null.spacemit");
			hash {
				algo = "crc32";
			};
		};

		rcpu0-dtb-com260 {
			description = "ESOS Core0 Com260 dtb";
			type = "standalone";
			os = "esos";
			arch = "riscv";
			compression = "none";
			load = <0x1 0xe05000>;
			entry = <0x1 0xe05000>;
			data = /incbin/("../output/esos/k3_rt240_com260.dtb");
			hash {
				algo = "crc32";
			};
		};

		rcpu0-dtb-deb1 {
			description = "ESOS Core0 Deb1 dtb";
			type = "standalone";
			os = "esos";
			arch = "riscv";
			compression = "none";
			load = <0x1 0xe11800>;
			entry = <0x1 0xe11800>;
			data = /incbin/("../output/esos/k3_rt240_deb1.dtb");
			hash {
				algo = "crc32";
			};
