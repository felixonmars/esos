			os = "esos";
			arch = "riscv";
			compression = "none";
			load = <0x1 0xe5c800>;
			entry = <0x1 0xe5c800>;
			data = /incbin/("../output/esos/k3_rt241_evb.dtb");
			hash {
				algo = "crc32";
			};
		};

		rcpu1-dtb-evb2_1 {
