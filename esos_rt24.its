			load = <0x1 0xe75800>;
			entry = <0x1 0xe75800>;
			data = /incbin/("../output/esos/k3_rt241_evb2_2.dtb");
			hash {
				algo = "crc32";
			};
		};

		rcpu0-dtb-dc-board {
			description = "ESOS Core0 dc_board dtb";
			type = "standalone";
			os = "esos";
			arch = "riscv";
			compression = "none";
			load = <0x1 0xe82000>;
			entry = <0x1 0xe82000>;
			data = /incbin/("../output/esos/k3_rt240_dc_board.dtb");
			hash {
				algo = "crc32";
			};
		};

		rcpu1-dtb-dc-board {
			description = "ESOS Core1 dc_board dtb";
			type = "standalone";
			os = "esos";
			arch = "riscv";
			compression = "none";
			load = <0x1 0xe8e800>;
			entry = <0x1 0xe8e800>;
			data = /incbin/("../output/esos/k3_rt241_dc_board.dtb");
			hash {
				algo = "crc32";
			};
		};

		rcpu0-dtb-com260-kit-v02 {
			description = "ESOS Core0 com260_kit_v02 dtb";
			type = "standalone";
			os = "esos";
			arch = "riscv";
			compression = "none";
			load = <0x1 0xe9b000>;
			entry = <0x1 0xe9b000>;
			data = /incbin/("../output/esos/k3_rt240_com260_kit_v02.dtb");
			hash {
				algo = "crc32";
			};
		};

		rcpu1-dtb-com260-kit-v02 {
			description = "ESOS Core1 com260_kit_v02 dtb";
			type = "standalone";
			os = "esos";
