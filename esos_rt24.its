/dts-v1/;

/ {
	description = "ESOS dual-core image for K3";
	#address-cells = <2>;

	images {
		rcpu-data-null {
			description = "Using data interaction with AP";
			type = "standalone";
			os = "esos";
			arch = "riscv";
			compression = "lzo";
			load = <0x1 0xe04000>;
			entry = <0x1 0xe04000>;
			data = /incbin/("../output/esos/null.spacemit.lzo");
			hash {
				algo = "crc32";
			};
		};

		rcpu0-dtb-com260 {
			description = "ESOS Core0 Com260 dtb";
			type = "standalone";
			os = "esos";
			arch = "riscv";
			compression = "lzo";
			load = <0x1 0xe05000>;
			entry = <0x1 0xe05000>;
			data = /incbin/("../output/esos/k3_rt240_com260.dtb.lzo");
			hash {
				algo = "crc32";
			};
		};

		rcpu0-dtb-deb1 {
			description = "ESOS Core0 Deb1 dtb";
			type = "standalone";
			os = "esos";
			arch = "riscv";
