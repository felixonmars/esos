			};
		};

		rcpu1-dtb-gemini-c1 {
			description = "ESOS Core1 gemini_c1 dtb";
			type = "standalone";
			os = "esos";
			arch = "riscv";
			compression = "none";
			load = <0x1 0xed9800>;
			entry = <0x1 0xed9800>;
			data = /incbin/("../output/esos/k3_rt241_gemini_c1.dtb");
			hash {
				algo = "crc32";
			};
		};

		rcpu0-fw {
			description = "ESOS Core0";
			type = "standalone";
			os = "esos";
			arch = "riscv";
			compression = "none";
			load = <0x1 0x200000>;
			entry = <0x1 0x200000>;
			data = /incbin/("../output/esos/rt24_os0_rcpu.elf");
			hash {
				algo = "crc32";
			};
		};

		rcpu1-fw {
			description = "ESOS Core1";
			type = "standalone";
			os = "esos";
			arch = "riscv";
			compression = "none";
