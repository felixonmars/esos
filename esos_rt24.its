			data = /incbin/("../output/esos/k3_rt240_evb.dtb");
			hash {
				algo = "crc32";
			};
		};

		rcpu0-dtb-evb2_1 {
			description = "ESOS Core0 Evb2_1 dtb";
			type = "standalone";
			os = "esos";
			arch = "riscv";
			compression = "none";
			load = <0x1 0xe2a800>;
			entry = <0x1 0xe2a800>;
			data = /incbin/("../output/esos/k3_rt240_evb2_1.dtb");
			hash {
				algo = "crc32";
			};
		};

		rcpu0-dtb-evb2_2 {
			description = "ESOS Core0 Evb2_2 dtb";
			type = "standalone";
			os = "esos";
			arch = "riscv";
			compression = "none";
			load = <0x1 0xe37000>;
			entry = <0x1 0xe37000>;
			data = /incbin/("../output/esos/k3_rt240_evb2_2.dtb");
