			type = "standalone";
			os = "esos";
			arch = "riscv";
			compression = "none";
			load = <0x1 0xe69000>;
			entry = <0x1 0xe69000>;
			data = /incbin/("../output/esos/k3_rt241_evb2_1.dtb");
