/dts-v1/;

#include "k3.dtsi"
#include "k3-pinctrl.h"

&pmx_core {
	status = "disabled";
        pinctrl-single,gpio-range = <
		&range GPIO_49  2 (MUX_MODE0 | EDGE_NONE | PULL_UP | PAD_3V_DS4)
	>;

	pinctrl_rcpu: pinctrl_rcpu_grp {
		pinctrl-single,pins = <
			K1X_PADCONF(GPIO_47, (MUX_MODE1 | EDGE_NONE | PULL_UP | PAD_3V_DS4))     /* r_uart0_tx */
			K1X_PADCONF(GPIO_48, (MUX_MODE1 | EDGE_NONE | PULL_UP | PAD_3V_DS4))     /* r_uart0_rx */
		>;
	};
};

&gpio {
	gpio-ranges = <&pmx_core 49  GPIO_49  2>;

	status = "disabled";
};

&uart0 {
	pinctrl-names = "default";
	status = "okay";
};

&mailbox3 {
	status = "disabled";
};

&mailbox4 {
	status = "okay";
};

&mailbox5 {
	status = "disabled";
};

&mailbox6 {
	status = "disabled";
};

&mailbox7 {
	interrupts = <0 66 0>;
	rcpu-communicate;
	status = "okay";
};

&rproc0 {
	status = "okay";
	mboxes = <&mailbox4 0>, <&mailbox4 1>;
};

&rpmi {
	status = "disabled";
};
