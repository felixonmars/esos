menu "Hardware Drivers Config"

menu "Onboard Peripheral Drivers"

endmenu

menu "On-chip Peripheral Drivers"

    config BSP_USING_PIN
        bool "Enable PINTRL"
        select RT_USING_PIN
        default y

    config BSP_USING_GPIO
        bool "Enable GPIO"
        select RT_USING_GPIO
        default y

    config BSP_USING_UART
        bool "Enable UART"
        default y
        select RT_USING_SERIAL

    config BSP_USING_ADMA
        bool "Enable ADMA"
        default n

    config BSP_USING_DMA
        bool "Enable DMA"
        default n

    config BSP_USING_CAN
        bool "Enable CAN"
        default n
        select RT_USING_CAN
        select RT_CAN_USING_CANFD

    config BSP_USING_I2C
        bool "Enable I2C"
        default n

    config BSP_USING_WDT
        bool "Enable Watchdog"
        default n
        select RT_USING_WDT

    config BSP_USING_IR
        bool "Enable IR"
        default n

    config BSP_USING_PM
        bool "Enable PM"
        default n
        select RT_USING_PM

    config BSP_USING_PWM
        bool "Enable PWM"
        default n

    config BSP_USING_SPI
        bool "Enable SPI"
        default n

    config BSP_USING_HWTIMER
        bool "Enable HWtimer"
        default n
        select RT_USING_HWTIMER

    config BSP_USING_HWSPINLOCK
        bool "Enable hwspinlock"
        default n
        select RT_USING_HWSPINLOCK

    config BSP_USING_MAILBOX
        bool "Enable MAILBOX"
        default n
        select RT_USING_MAILBOX

    config BSP_USING_RPMSG
        bool "Enable rpmsg"
        default y
        select RT_USING_RPMSG_SERVICE

    config BSP_USING_REGULATOR
        bool "Enable regulator"
        default y
        select RT_USING_REGULATOR

    if BSP_USING_REGULATOR
       config BSP_REGULATOR_TEST
          bool "Enable regulator test driver"
          default n
    endif

    config BSP_USING_GMAC
        bool "Enable GMAC"
        default n

endmenu

menu "Board extended module Drivers"

endmenu

endmenu

menu "Platform Config"

choice
    prompt "select chip type"
    default SOC_SPACEMIT_K1_X

    config SOC_SPACEMIT_K1_X
    bool "SOC_SPACEMIT_K1_X"
        select RT_USING_COMPONENTS_INIT
        select RT_USING_USER_MAIN
        select ARCH_RISCV32
        select RT_USING_CACHE


    config SOC_SPACEMIT_K3
    bool "SOC_SPACEMIT_K3"
        select RT_USING_COMPONENTS_INIT
        select RT_USING_USER_MAIN
        select ARCH_RISCV64
        select ARCH_RISCV_FPU
        select ARCH_RISCV_FPU_D
        select RT_USING_CACHE

if SOC_SPACEMIT_K3
    choice
        prompt "select OS"
        default SOC_SPACEMIT_K3_CORE0

        config SOC_SPACEMIT_K3_CORE0
        bool "Energy OS"


        config SOC_SPACEMIT_K3_CORE1
        bool "Runtime OS"
    endchoice
endif
endchoice
endmenu
