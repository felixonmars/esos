#!/usr/bin/make -f
# Debian rules file for ESOS

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE = 1

# Set environment variables for the build
export TOP_DIR = $(CURDIR)
export TOP_BSP_DIR = $(TOP_DIR)/bsp/spacemit
export TOP_ESOS_BASE_DEFCONF = $(TOP_BSP_DIR)/.esos_top.config
export TOP_CROSS_COMPILE=riscv64-unknown-elf-

# get the commit ID
GIT_INSIDE := $(shell git rev-parse --is-inside-work-tree 2>/dev/null)
ifeq ($(GIT_INSIDE),true)
	COMMIT_ID := $(shell git rev-parse --short HEAD)
endif

%:
	dh $@

override_dh_auto_configure:
	sed -i "s/XBS-Commit-Id:.*/XBS-Commit-Id: $(COMMIT_ID)/" debian/control
	# Create base configuration for k3_all_cores
	echo "export TOP_TARGET_CHIP=rt24" > $(TOP_ESOS_BASE_DEFCONF)

override_dh_auto_build:
	# Use the build.sh script to build the project
	cp $(TOP_DIR)/debian/lib/* /usr/lib/gcc/riscv64-unknown-elf/14.2.0/
	RTT_EXEC_PATH=/usr/bin $(TOP_DIR)/build_top.sh

override_dh_auto_clean:
	# Clean build artifacts
	if [ -f $(TOP_DIR)/$(TOP_ESOS_BASE_DEFCONF) ]; then \
		$(TOP_DIR)/build.sh clean || true; \
	fi
	rm -f $(TOP_ESOS_BASE_DEFCONF)
	rm -f $(TOP_BSP_DIR)/*.itb $(TOP_BSP_DIR)/*.elf $(TOP_BSP_DIR)/*.bin
	rm -f $(TOP_BSP_DIR)/platform/rt24/*.dtb
